node_modules/
.next/
out/
.env*
!.env.example
*.symlink.bak
.DS_Store

# Large media. Editing masters stay out of git; anything the SITE requests at
# runtime must be in, or a fresh clone deploys with a hole in it.
#
# The blanket rules came first and every negation below is a specific asset
# the built page fetches. Checked with `git check-ignore -v` on each path
# rather than assumed — the hero film was untracked under a bare *.mp4 and a
# deploy from this repo would have had no film at all.
*.mp4
*.webm
*.mov
*.mkv
*.jpg
*.jpeg
*.png

# The hero: AV1 primary, H.264 fallback, webm, and the idle loop.
!public/video/*.mp4
!public/video/*.webm

# The phone tour's model, and its screen textures at both resolutions.
!public/models/**

# Everything under public/images, at any depth — the scroll-stack photographs
# live in a subdirectory and `public/images/*` does not reach them.
!public/images/**

# Test harness working files
build/*.log
build/results*.jsonl
build/ladder/
build/intermediate*

# stray logs at root
*.log

# next dev regenerates these on every run
AGENTS.md
CLAUDE.md

# tsc incremental cache
*.tsbuildinfo

# Chrome headless profiles must NEVER live in the project tree — Turbopack
# watches it and panics on the locked shared_proto_db/LOCK file.
build/cp*/
build/chrome-profile/

.vercel
